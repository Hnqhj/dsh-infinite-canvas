{
  "name": "dsh-infinite-canvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "无限画布 —— 把 NexusVault 的无限画布接进 DeepSeek Harness 的右侧栏，并让对话直接操控画布。",
  "license": "MIT",
  "author": "Hnqhj",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "infinite-canvas",
    "nexusvault",
    "storyboard"
  ],
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node tools/smoke-test.mjs",
    "sync": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/sync-all.ps1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
